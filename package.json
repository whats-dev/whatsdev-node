{
  "name": "@whatsdev/sdk",
  "version": "0.1.0",
  "description": "Official Node.js client for the WhatsDev WhatsApp API: sessions, messaging, contacts, bulk sends, templates and signed webhooks",
  "keywords": ["whatsapp", "whatsdev", "messaging", "api-client", "sdk", "webhooks", "typescript"],
  "homepage": "https://whats.youdev.online/docs",
  "repository": { "type": "git", "url": "git+https://github.com/whats-dev/whatsdev-node.git" },
  "bugs": { "url": "https://github.com/whats-dev/whatsdev-node/issues" },
  "author": "WhatsDev",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
